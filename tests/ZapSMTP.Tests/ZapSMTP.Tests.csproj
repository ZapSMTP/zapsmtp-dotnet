<Project Sdk="Microsoft.NET.Sdk">

  <!--
    dotnet test                                   tests the net8.0 build of the library
    dotnet test -p:ZapLibTfm=netstandard2.0       tests its netstandard2.0 build
    dotnet test -p:TestTargetFramework=net9.0     runs on .NET 9
    Coverage of the library is collected on every run and must be 100% of lines and branches.
  -->
  <PropertyGroup>
    <TestTargetFramework Condition="'$(TestTargetFramework)' == ''">net8.0</TestTargetFramework>
    <TargetFramework>$(TestTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ZapSMTP.Tests</RootNamespace>
    <!-- test method names use underscores -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildThisFileDirectory)TestResults/coverage-$(ZapLibTfm)$(TestTargetFramework).xml</CoverletOutput>
    <Include>[ZapSMTP]*,[ZapSMTP.Extensions.DependencyInjection]*</Include>
    <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
    <Threshold>100</Threshold>
    <ThresholdType>line,branch</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="coverlet.msbuild" Version="6.0.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(ZapLibTfm)' == ''">
    <ProjectReference Include="..\..\src\ZapSMTP\ZapSMTP.csproj" />
    <ProjectReference Include="..\..\src\ZapSMTP.Extensions.DependencyInjection\ZapSMTP.Extensions.DependencyInjection.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ZapLibTfm)' != ''">
    <!-- what an app on .NET Core 3+ resolves for the netstandard2.0 build: IAsyncEnumerable forwarded to the runtime -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <ProjectReference Include="..\..\src\ZapSMTP\ZapSMTP.csproj" SetTargetFramework="TargetFramework=$(ZapLibTfm)" />
    <ProjectReference Include="..\..\src\ZapSMTP.Extensions.DependencyInjection\ZapSMTP.Extensions.DependencyInjection.csproj" SetTargetFramework="TargetFramework=$(ZapLibTfm)" />
  </ItemGroup>

</Project>
